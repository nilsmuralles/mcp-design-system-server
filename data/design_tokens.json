{
  "colors": {
    "primary": {
      "500": "#2563eb",
      "600": "#1d4ed8"
    },
    "danger": {
      "500": "#dc2626",
      "600": "#b91c1c"
    },
    "success": {
      "500": "#16a34a"
    },
    "neutral": {
      "0": "#ffffff",
